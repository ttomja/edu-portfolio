---
import { siteConfig, navLinks } from "../data/siteData";
---

<nav class="fixed top-0 left-0 right-0 z-50 bg-neutral-950/75 backdrop-blur-lg border-b border-white/5">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-4 flex items-center justify-between gap-4">
    <a href="/" class="group flex min-w-0 items-center gap-3" aria-label={`${siteConfig.name} portfolio home`}>
      <span class="relative grid h-10 w-10 shrink-0 place-items-center overflow-hidden rounded-xl border border-white/10 bg-neutral-900 shadow-[inset_0_1px_0_rgba(255,255,255,0.08)]">
        <span class="absolute inset-0 bg-[linear-gradient(135deg,rgba(99,102,241,0.24),transparent_45%,rgba(20,184,166,0.16))]"></span>
        <span class="relative text-sm font-black text-white">TT</span>
      </span>
      <span class="min-w-0">
        <span class="flex items-center gap-2">
          <span class="block truncate text-base font-bold text-white sm:text-lg">
            {siteConfig.name}
          </span>
          <span class="hidden rounded-full border border-white/10 bg-white/[0.04] px-2 py-0.5 text-[10px] font-bold uppercase tracking-widest text-indigo-200 sm:inline-flex">
            {siteConfig.brandLabel}
          </span>
        </span>
        <span class="block truncate text-[11px] text-neutral-500 transition-colors group-hover:text-neutral-400 sm:text-xs">
          {siteConfig.title}
        </span>
      </span>
    </a>

    <div class="hidden md:flex items-center gap-8">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="text-sm font-medium text-neutral-400 hover:text-white focus-visible:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-400/60 rounded-sm transition-colors"
          >
            {link.name}
          </a>
        ))
      }
      <a
        href={`mailto:${siteConfig.email}`}
        class="px-5 py-2.5 text-sm font-bold text-neutral-950 bg-white rounded-full hover:bg-neutral-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-400/70 transition-all"
      >
        Contact
      </a>
    </div>

    <div class="md:hidden flex items-center gap-1.5">
      <a
        href="/projects"
        class="px-2 py-2 text-[10px] font-semibold text-neutral-300 border border-white/10 rounded-full bg-white/5"
      >
        Projects
      </a>
      <a
        href="/resume"
        class="px-2 py-2 text-[10px] font-semibold text-neutral-300 border border-white/10 rounded-full bg-white/5"
      >
        Resume
      </a>
      <a
        href="/education"
        class="px-2 py-2 text-[10px] font-semibold text-neutral-950 bg-white rounded-full"
      >
        IT 6
      </a>
    </div>
  </div>
</nav>
