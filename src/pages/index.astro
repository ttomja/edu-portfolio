---
import Layout from "../layouts/Layout.astro";
import ServiceCard from "../components/ServiceCard.astro";
import ExperienceItem from "../components/ExperienceItem.astro";
import Hero from "../components/Hero.astro";
import Footer from "../components/Footer.astro";
import Navbar from "../components/Navbar.astro";
import TechStack from "../components/TechStack.astro";
import {
  workExperience,
  services,
  sectionContent,
} from "../data/siteData";
---

<Layout title="Tom Tumanan | Web Developer & IT Support Freelancer">
  <Navbar />
  <Hero />

  <section id="about" class="py-24 border-y border-white/5 bg-neutral-900/30">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 grid lg:grid-cols-[0.9fr_1.1fr] gap-10 lg:gap-16 items-start">
      <div class="scroll-fade">
        <p class="text-sm font-bold text-neutral-500 uppercase tracking-widest mb-4">
          Profile
        </p>
        <h2 class="text-3xl md:text-5xl font-bold text-white leading-tight mb-6">
          {sectionContent.about.title}
        </h2>
        <p class="text-neutral-400 text-lg leading-relaxed">
          {sectionContent.about.description}
        </p>
      </div>

      <div class="scroll-fade grid gap-4">
        {
          sectionContent.about.highlights.map((highlight, index) => (
            <div class="bg-neutral-950/70 border border-white/10 rounded-2xl p-6">
              <div class="text-sm font-mono text-indigo-400 mb-3">
                {(index + 1).toString().padStart(2, "0")}
              </div>
              <p class="text-neutral-300 leading-relaxed">{highlight}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <TechStack />

  <section id="services" class="py-24 relative overflow-hidden border-y border-white/5 bg-[#050706]">
    <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(120deg,rgba(16,185,129,0.08),transparent_34%),linear-gradient(300deg,rgba(59,130,246,0.08),transparent_42%)]"></div>
    <div
      class="pointer-events-none absolute inset-0 opacity-[0.18]"
      style="background-image: repeating-linear-gradient(135deg, rgba(255,255,255,0.08) 0 1px, transparent 1px 28px);"
    >
    </div>
    <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-emerald-400/50 to-transparent"></div>
    <div class="pointer-events-none absolute inset-x-0 bottom-0 h-px bg-gradient-to-r from-transparent via-blue-400/35 to-transparent"></div>
    <div class="pointer-events-none absolute left-6 top-16 bottom-16 hidden w-px bg-gradient-to-b from-transparent via-emerald-400/25 to-transparent lg:block"></div>
    <div class="pointer-events-none absolute right-6 top-16 bottom-16 hidden w-px bg-gradient-to-b from-transparent via-blue-400/25 to-transparent lg:block"></div>

    <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6">
      <div class="scroll-fade text-center max-w-3xl mx-auto mb-12">
        <p class="text-sm font-bold text-emerald-300/80 uppercase tracking-widest mb-4">
          {sectionContent.services.title}
        </p>
        <p class="text-neutral-400 text-lg leading-relaxed">
          {sectionContent.services.subtitle}
        </p>
      </div>

      <div class="scroll-fade grid grid-cols-1 md:grid-cols-2 gap-6">
        {
          services.map((service) => (
            <ServiceCard
              title={service.title}
              icon={service.icon}
              description={service.description}
            />
          ))
        }
      </div>
    </div>
  </section>

  <section id="experience" class="py-28 relative overflow-hidden border-b border-white/5 bg-[#050507]">
    <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(90deg,transparent,rgba(99,102,241,0.08)_48%,rgba(16,185,129,0.06)_50%,transparent_60%)]"></div>
    <div
      class="pointer-events-none absolute inset-0 opacity-[0.16]"
      style="background-image: repeating-linear-gradient(90deg, transparent 0 110px, rgba(255,255,255,0.08) 110px 111px), repeating-linear-gradient(0deg, transparent 0 42px, rgba(255,255,255,0.06) 42px 43px);"
    >
    </div>
    <div class="pointer-events-none absolute left-1/2 top-0 hidden h-full w-48 -translate-x-1/2 bg-gradient-to-r from-transparent via-indigo-500/10 to-transparent md:block"></div>
    <div class="pointer-events-none absolute left-0 right-0 top-24 hidden h-px bg-gradient-to-r from-transparent via-white/10 to-transparent md:block"></div>

    <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6">
      <div class="scroll-fade mb-16 text-center">
        <h2 class="text-4xl md:text-5xl font-bold text-white mb-4">
          {sectionContent.experience.title}
        </h2>
        <p class="text-neutral-400 max-w-2xl mx-auto">
          {sectionContent.experience.subtitle}
        </p>
      </div>

      <div class="relative">
        <div class="hidden md:block absolute left-1/2 top-0 bottom-0 w-px bg-gradient-to-b from-transparent via-indigo-400/35 to-emerald-400/20 -translate-x-1/2"></div>

        <div class="space-y-0">
          {
            workExperience.map((job, index) => (
              <ExperienceItem
                index={index}
                role={job.role}
                company={job.company}
                period={job.period}
                description={job.description}
                skills={job.skills}
              />
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
