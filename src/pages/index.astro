---
import Layout from "../layouts/Layout.astro";
import ServiceCard from "../components/ServiceCard.astro";
import ExperienceItem from "../components/ExperienceItem.astro";
import Hero from "../components/Hero.astro";
import Footer from "../components/Footer.astro";
import Navbar from "../components/Navbar.astro";
import TechStack from "../components/TechStack.astro";
import {
  workExperience,
  services,
  sectionContent,
} from "../data/siteData";
---

<Layout title="Tom Tumanan | Web Developer & IT Support Freelancer">
  <Navbar />
  <Hero />

  <section id="about" class="py-24 border-y border-white/5 bg-neutral-900/30">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 grid lg:grid-cols-[0.9fr_1.1fr] gap-10 lg:gap-16 items-start">
      <div class="scroll-fade">
        <p class="text-sm font-bold text-neutral-500 uppercase tracking-widest mb-4">
          Profile
        </p>
        <h2 class="text-3xl md:text-5xl font-bold text-white leading-tight mb-6">
          {sectionContent.about.title}
        </h2>
        <p class="text-neutral-400 text-lg leading-relaxed">
          {sectionContent.about.description}
        </p>
      </div>

      <div class="scroll-fade grid gap-4">
        {
          sectionContent.about.highlights.map((highlight, index) => (
            <div class="bg-neutral-950/70 border border-white/10 rounded-2xl p-6">
              <div class="text-sm font-mono text-indigo-400 mb-3">
                {(index + 1).toString().padStart(2, "0")}
              </div>
              <p class="text-neutral-300 leading-relaxed">{highlight}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <TechStack />

  <section id="services" class="py-24 relative overflow-hidden border-y border-white/5 bg-neutral-950">
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_18%_20%,rgba(99,102,241,0.08),transparent_30%),radial-gradient(circle_at_82%_75%,rgba(255,255,255,0.035),transparent_28%)]"></div>
    <div
      class="pointer-events-none absolute inset-0 opacity-[0.12]"
      style="background-image: radial-gradient(rgba(255,255,255,0.18) 1px, transparent 1px); background-size: 24px 24px;"
    >
    </div>
    <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-white/10 to-transparent"></div>
    <div class="pointer-events-none absolute inset-x-0 bottom-0 h-px bg-gradient-to-r from-transparent via-white/10 to-transparent"></div>

    <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6">
      <div class="scroll-fade text-center max-w-3xl mx-auto mb-12">
        <p class="text-sm font-bold text-neutral-500 uppercase tracking-widest mb-4">
          {sectionContent.services.title}
        </p>
        <p class="text-neutral-400 text-lg leading-relaxed">
          {sectionContent.services.subtitle}
        </p>
      </div>

      <div class="scroll-fade grid grid-cols-1 md:grid-cols-2 gap-6">
        {
          services.map((service) => (
            <ServiceCard
              title={service.title}
              icon={service.icon}
              description={service.description}
            />
          ))
        }
      </div>
    </div>
  </section>

  <section id="experience" class="py-28 relative overflow-hidden border-b border-white/5 bg-neutral-950">
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_50%_18%,rgba(99,102,241,0.09),transparent_34%),linear-gradient(to_bottom,rgba(255,255,255,0.02),transparent_45%)]"></div>
    <div
      class="pointer-events-none absolute inset-0 opacity-[0.1]"
      style="background-image: linear-gradient(to right, rgba(255,255,255,0.14) 1px, transparent 1px), linear-gradient(to bottom, rgba(255,255,255,0.14) 1px, transparent 1px); background-size: 48px 48px;"
    >
    </div>
    <div class="pointer-events-none absolute left-1/2 top-0 hidden h-full w-36 -translate-x-1/2 bg-gradient-to-r from-transparent via-white/[0.025] to-transparent md:block"></div>
    <div class="pointer-events-none absolute left-0 right-0 top-24 hidden h-px bg-gradient-to-r from-transparent via-white/10 to-transparent md:block"></div>

    <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6">
      <div class="scroll-fade mb-16 text-center">
        <h2 class="text-4xl md:text-5xl font-bold text-white mb-4">
          {sectionContent.experience.title}
        </h2>
        <p class="text-neutral-400 max-w-2xl mx-auto">
          {sectionContent.experience.subtitle}
        </p>
      </div>

      <div class="relative">
        <div class="hidden md:block absolute left-1/2 top-0 bottom-0 w-px bg-gradient-to-b from-transparent via-white/10 to-transparent -translate-x-1/2"></div>

        <div class="space-y-0">
          {
            workExperience.map((job, index) => (
              <ExperienceItem
                index={index}
                role={job.role}
                company={job.company}
                period={job.period}
                description={job.description}
                skills={job.skills}
              />
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
