---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { resumeProfile, sectionContent, siteConfig } from "../data/siteData";

const hasResume = siteConfig.resumeUrl.length > 0;

const contactLinks = [
  {
    label: "Email",
    value: resumeProfile.emails[0],
    href: `mailto:${resumeProfile.emails[0]}`,
  },
  {
    label: "Student Email",
    value: resumeProfile.emails[1],
    href: `mailto:${resumeProfile.emails[1]}`,
  },
  {
    label: "GitHub",
    value: "github.com/ttomja",
    href: siteConfig.social.github,
  },
  {
    label: "LinkedIn",
    value: "LinkedIn Profile",
    href: siteConfig.social.linkedin,
  },
];
---

<Layout description={sectionContent.resume.description}>
  <Navbar />

  <section class="pt-28 md:pt-32 pb-14 px-4 sm:px-6">
    <div class="max-w-6xl mx-auto grid gap-8 lg:grid-cols-[1.1fr_0.9fr] items-start">
      <div class="scroll-fade">
        <p class="text-sm font-bold text-neutral-500 uppercase tracking-widest mb-4">
          Resume Showcase
        </p>
        <h1 class="text-4xl md:text-6xl font-bold text-white leading-tight mb-4">
          {resumeProfile.fullName}
        </h1>
        <p class="text-xl md:text-2xl text-indigo-300 font-semibold mb-6">
          {resumeProfile.role}
        </p>
        <p class="text-neutral-300 text-lg leading-relaxed max-w-3xl">
          {resumeProfile.summary}
        </p>

        <div class="mt-8 flex flex-wrap gap-3">
          {
            contactLinks.map((link) => (
              <a
                href={link.href}
                target={link.href.startsWith("mailto:") ? undefined : "_blank"}
                rel={link.href.startsWith("mailto:") ? undefined : "noopener noreferrer"}
                class="rounded-full border border-white/10 bg-white/[0.04] px-4 py-2 text-sm text-neutral-300 transition-colors hover:border-indigo-400/50 hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-400/70"
              >
                <span class="font-semibold text-white">{link.label}:</span>{" "}
                {link.value}
              </a>
            ))
          }
        </div>

        <div class="mt-8 flex flex-wrap gap-3">
          {
            hasResume ? (
              <a
                href={siteConfig.resumeUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center rounded-full bg-white px-6 py-3 text-sm font-bold text-neutral-950 transition-colors hover:bg-neutral-200"
              >
                {sectionContent.resume.readyLabel}
              </a>
            ) : (
              <span
                aria-disabled="true"
                class="inline-flex cursor-not-allowed items-center justify-center rounded-full border border-white/10 bg-white/10 px-6 py-3 text-sm font-bold text-neutral-400"
              >
                {sectionContent.resume.pendingLabel}
              </span>
            )
          }
          <a
            href="/projects"
            class="inline-flex items-center justify-center rounded-full border border-white/10 px-6 py-3 text-sm font-bold text-white transition-colors hover:border-indigo-400/50 hover:bg-white/[0.04]"
          >
            View Project Proof
          </a>
        </div>
      </div>

      <aside class="scroll-fade rounded-lg border border-white/10 bg-neutral-900/70 p-6">
        <p class="text-sm font-bold text-neutral-500 uppercase tracking-widest mb-4">
          Web Developer Focus
        </p>
        <div class="space-y-4">
          {
            resumeProfile.webDeveloperFocus.map((item) => (
              <div class="border-l border-indigo-400/50 pl-4">
                <p class="text-neutral-300 leading-relaxed">{item}</p>
              </div>
            ))
          }
        </div>
      </aside>
    </div>
  </section>

  <section class="pb-24 md:pb-32 px-4 sm:px-6">
    <div class="max-w-6xl mx-auto space-y-10">
      <div class="scroll-fade">
        <p class="text-sm font-bold text-neutral-500 uppercase tracking-widest mb-4">
          Relevant Skills
        </p>
        <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
          {
            resumeProfile.skillGroups.map((group) => (
              <article class="rounded-lg border border-white/10 bg-neutral-900/60 p-5">
                <h2 class="text-lg font-bold text-white mb-4">{group.title}</h2>
                <div class="flex flex-wrap gap-2">
                  {
                    group.items.map((item) => (
                      <span class="rounded-full border border-white/10 bg-white/[0.04] px-3 py-1.5 text-xs font-medium text-neutral-300">
                        {item}
                      </span>
                    ))
                  }
                </div>
              </article>
            ))
          }
        </div>
      </div>

      <div class="grid gap-6 lg:grid-cols-[1.05fr_0.95fr]">
        <section class="scroll-fade rounded-lg border border-white/10 bg-neutral-900/60 p-6">
          <p class="text-sm font-bold text-neutral-500 uppercase tracking-widest mb-5">
            Work Experience
          </p>
          {
            resumeProfile.experience.map((job) => (
              <article>
                <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
                  <div>
                    <h2 class="text-2xl font-bold text-white">{job.role}</h2>
                    <p class="text-indigo-300 font-semibold">
                      {job.company} - {job.type}
                    </p>
                  </div>
                  <span class="w-fit rounded-full border border-white/10 bg-white/[0.04] px-3 py-1 text-xs font-bold text-neutral-300">
                    {job.period}
                  </span>
                </div>
                <ul class="mt-5 space-y-3 text-neutral-300">
                  {
                    job.bullets.map((bullet) => (
                      <li class="flex gap-3 leading-relaxed">
                        <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-indigo-400"></span>
                        <span>{bullet}</span>
                      </li>
                    ))
                  }
                </ul>
              </article>
            ))
          }
        </section>

        <section class="scroll-fade rounded-lg border border-white/10 bg-neutral-900/60 p-6">
          <p class="text-sm font-bold text-neutral-500 uppercase tracking-widest mb-5">
            Education
          </p>
          <div class="space-y-6">
            {
              resumeProfile.education.map((item) => (
                <article class="border-l border-white/10 pl-4">
                  <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
                    <div>
                      <h2 class="text-xl font-bold text-white">{item.school}</h2>
                      <p class="text-sm font-semibold text-indigo-300">
                        {item.level}
                      </p>
                    </div>
                    <span class="w-fit rounded-full border border-white/10 bg-white/[0.04] px-3 py-1 text-xs font-bold text-neutral-300">
                      {item.period}
                    </span>
                  </div>
                  <p class="mt-3 text-neutral-300 leading-relaxed">{item.program}</p>
                </article>
              ))
            }
          </div>
        </section>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
