---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { projects, resumeProfile, sectionContent, siteConfig } from "../data/siteData";

const hasResume = siteConfig.resumeUrl.length > 0;
const featuredProject = projects[0];

const contactLinks = [
  {
    label: "Email",
    value: resumeProfile.emails[0],
    href: `mailto:${resumeProfile.emails[0]}`,
  },
  {
    label: "Student Email",
    value: resumeProfile.emails[1],
    href: `mailto:${resumeProfile.emails[1]}`,
  },
  {
    label: "GitHub",
    value: "github.com/ttomja",
    href: siteConfig.social.github,
  },
  {
    label: "LinkedIn",
    value: "Profile",
    href: siteConfig.social.linkedin,
  },
];
---

<Layout description={sectionContent.resume.description}>
  <Navbar />

  <section class="relative overflow-hidden px-4 pb-24 pt-28 sm:px-6 md:pt-32">
    <div class="pointer-events-none absolute inset-0 opacity-[0.045] [background-image:linear-gradient(to_right,rgba(255,255,255,0.16)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.16)_1px,transparent_1px)] [background-size:48px_48px]"></div>

    <div class="relative mx-auto grid max-w-7xl gap-6 lg:grid-cols-[320px_1fr]">
      <aside class="scroll-fade lg:sticky lg:top-28">
        <div class="overflow-hidden rounded-lg border border-white/10 bg-neutral-950/90 shadow-2xl shadow-black/40">
          <div class="relative h-44 border-b border-white/10 bg-neutral-900">
            <img
              src={resumeProfile.portrait}
              alt={`${resumeProfile.fullName} portrait`}
              class="h-full w-full object-cover object-top grayscale"
              loading="eager"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-neutral-950 via-neutral-950/15 to-transparent"></div>
          </div>

          <div class="p-6">
            <p class="mb-3 text-xs font-bold uppercase tracking-[0.24em] text-indigo-300">
              Resume Profile
            </p>
            <h1 class="text-3xl font-black leading-tight text-white">
              {resumeProfile.fullName}
            </h1>
            <p class="mt-2 text-sm font-semibold text-neutral-400">
              {resumeProfile.role}
            </p>

            <div class="mt-6 grid grid-cols-2 gap-2">
              {
                resumeProfile.proofStats.map((stat) => (
                  <div class="rounded-lg border border-white/10 bg-white/[0.035] p-3">
                    <div class="text-lg font-black text-white">{stat.value}</div>
                    <div class="mt-1 text-[11px] font-medium uppercase tracking-wide text-neutral-500">
                      {stat.label}
                    </div>
                  </div>
                ))
              }
            </div>

            <div class="mt-6 space-y-2">
              {
                contactLinks.map((link) => (
                  <a
                    href={link.href}
                    target={link.href.startsWith("mailto:") ? undefined : "_blank"}
                    rel={link.href.startsWith("mailto:") ? undefined : "noopener noreferrer"}
                    class="flex items-center justify-between gap-3 rounded-lg border border-white/10 bg-white/[0.03] px-3 py-2 text-sm text-neutral-300 transition-colors hover:border-indigo-400/40 hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-400/70"
                  >
                    <span class="font-bold text-white">{link.label}</span>
                    <span class="truncate text-right text-xs text-neutral-500">{link.value}</span>
                  </a>
                ))
              }
            </div>

            <div class="mt-6 flex flex-col gap-3">
              {
                hasResume ? (
                  <a
                    href={siteConfig.resumeUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center justify-center rounded-full bg-white px-5 py-3 text-sm font-bold text-neutral-950 transition-colors hover:bg-neutral-200"
                  >
                    {sectionContent.resume.readyLabel}
                  </a>
                ) : (
                  <span
                    aria-disabled="true"
                    class="inline-flex cursor-not-allowed items-center justify-center rounded-full border border-white/10 bg-white/10 px-5 py-3 text-sm font-bold text-neutral-400"
                  >
                    {sectionContent.resume.pendingLabel}
                  </span>
                )
              }
              <a
                href="/projects"
                class="inline-flex items-center justify-center rounded-full border border-white/10 px-5 py-3 text-sm font-bold text-white transition-colors hover:border-indigo-400/50 hover:bg-white/[0.04]"
              >
                View Project Proof
              </a>
            </div>
          </div>
        </div>
      </aside>

      <div class="space-y-6">
        <header class="scroll-fade rounded-lg border border-white/10 bg-neutral-950/80 p-6 md:p-8">
          <div class="flex flex-col gap-6 xl:flex-row xl:items-end xl:justify-between">
            <div>
              <p class="mb-4 text-sm font-bold uppercase tracking-[0.28em] text-neutral-500">
                Developer Resume
              </p>
              <h2 class="max-w-4xl text-4xl font-black leading-tight text-white md:text-6xl">
                Proof-first web developer profile.
              </h2>
              <p class="mt-5 max-w-3xl text-lg leading-relaxed text-neutral-300">
                {resumeProfile.summary}
              </p>
            </div>
            <div class="grid min-w-64 grid-cols-2 gap-2">
              <div class="rounded-lg border border-indigo-400/25 bg-indigo-500/10 p-4">
                <div class="text-2xl font-black text-white">FEFO</div>
                <div class="mt-1 text-xs uppercase tracking-wide text-indigo-200">
                  Inventory logic
                </div>
              </div>
              <div class="rounded-lg border border-emerald-400/20 bg-emerald-500/10 p-4">
                <div class="text-2xl font-black text-white">RLS</div>
                <div class="mt-1 text-xs uppercase tracking-wide text-emerald-200">
                  Access control
                </div>
              </div>
            </div>
          </div>
        </header>

        <section class="scroll-fade grid gap-4 md:grid-cols-3">
          {
            resumeProfile.proofCards.map((card) => (
              <article class="group rounded-lg border border-white/10 bg-neutral-950/80 p-5 transition-all duration-300 hover:-translate-y-1 hover:border-indigo-400/40">
                <p class="mb-3 text-[11px] font-bold uppercase tracking-[0.2em] text-indigo-300">
                  {card.eyebrow}
                </p>
                <h3 class="text-xl font-bold text-white">{card.title}</h3>
                <p class="mt-3 text-sm leading-relaxed text-neutral-400">
                  {card.text}
                </p>
              </article>
            ))
          }
        </section>

        <section class="scroll-fade overflow-hidden rounded-lg border border-white/10 bg-neutral-950/80">
          <div class="grid gap-0 xl:grid-cols-[1fr_0.95fr]">
            <div class="relative min-h-72 overflow-hidden border-b border-white/10 bg-neutral-900 xl:border-b-0 xl:border-r">
              <img
                src={featuredProject.imagePath}
                alt={featuredProject.imageAlt}
                class="h-full min-h-72 w-full object-cover object-left-top"
                loading="lazy"
              />
              <div class="absolute left-4 top-4 rounded-full border border-white/10 bg-neutral-950/80 px-3 py-1 text-xs font-bold uppercase tracking-wider text-white backdrop-blur">
                Featured Build
              </div>
            </div>

            <div class="p-6 md:p-8">
              <p class="mb-3 text-xs font-bold uppercase tracking-[0.22em] text-indigo-300">
                {featuredProject.role}
              </p>
              <h3 class="text-3xl font-black leading-tight text-white">
                {featuredProject.title}
              </h3>
              <p class="mt-4 text-neutral-300 leading-relaxed">
                {featuredProject.description}
              </p>

              <div class="mt-6 grid gap-3 sm:grid-cols-2">
                {
                  resumeProfile.featuredFocus.map((item) => (
                    <div class="rounded-lg border border-white/10 bg-white/[0.035] p-3 text-sm font-medium text-neutral-300">
                      {item}
                    </div>
                  ))
                }
              </div>

              <div class="mt-6 flex flex-wrap gap-2">
                {
                  featuredProject.techStack.map((tech) => (
                    <span class="rounded-full border border-indigo-400/20 bg-indigo-500/10 px-3 py-1 text-xs font-bold text-indigo-200">
                      {tech}
                    </span>
                  ))
                }
              </div>

              <div class="mt-7 flex flex-wrap gap-3">
                <a
                  href={featuredProject.demoUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="rounded-full bg-white px-5 py-3 text-sm font-bold text-neutral-950 transition-colors hover:bg-neutral-200"
                >
                  Live Demo
                </a>
                <a
                  href={featuredProject.repoUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="rounded-full border border-white/10 px-5 py-3 text-sm font-bold text-white transition-colors hover:border-indigo-400/50 hover:bg-white/[0.04]"
                >
                  Source Code
                </a>
              </div>
            </div>
          </div>
        </section>

        <section class="scroll-fade rounded-lg border border-white/10 bg-neutral-950/80 p-6 md:p-8">
          <div class="mb-6 flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
            <div>
              <p class="mb-3 text-sm font-bold uppercase tracking-[0.28em] text-neutral-500">
                Skill Board
              </p>
              <h3 class="text-3xl font-black text-white">What I can work with</h3>
            </div>
            <p class="max-w-md text-sm text-neutral-500">
              Grouped by the areas I can use on web builds, support tasks, and technical operations.
            </p>
          </div>

          <div class="grid gap-4 md:grid-cols-2">
            {
              resumeProfile.skillGroups.map((group) => (
                <article class="rounded-lg border border-white/10 bg-white/[0.03] p-5">
                  <div class="mb-4 flex items-start justify-between gap-4">
                    <div>
                      <h4 class="text-lg font-bold text-white">{group.title}</h4>
                      <p class="mt-1 text-xs font-bold uppercase tracking-widest text-indigo-300">
                        {group.level}
                      </p>
                    </div>
                    <div class="h-2 w-16 rounded-full bg-white/10">
                      <div class="h-full w-4/5 rounded-full bg-gradient-to-r from-indigo-400 to-cyan-300"></div>
                    </div>
                  </div>
                  <div class="flex flex-wrap gap-2">
                    {
                      group.items.map((item) => (
                        <span class="rounded-full border border-white/10 bg-neutral-950 px-3 py-1.5 text-xs font-medium text-neutral-300">
                          {item}
                        </span>
                      ))
                    }
                  </div>
                </article>
              ))
            }
          </div>
        </section>

        <section class="scroll-fade grid gap-6 lg:grid-cols-2">
          <div class="rounded-lg border border-white/10 bg-neutral-950/80 p-6">
            <p class="mb-5 text-sm font-bold uppercase tracking-[0.24em] text-neutral-500">
              Work Experience
            </p>
            {
              resumeProfile.experience.map((job) => (
                <article class="rounded-lg border border-white/10 bg-white/[0.03] p-5">
                  <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
                    <div>
                      <h3 class="text-xl font-bold text-white">{job.role}</h3>
                      <p class="mt-1 text-sm font-semibold text-indigo-300">
                        {job.company} - {job.type}
                      </p>
                    </div>
                    <span class="w-fit rounded-full border border-white/10 bg-neutral-950 px-3 py-1 text-xs font-bold text-neutral-300">
                      {job.period}
                    </span>
                  </div>
                  <ul class="mt-5 grid gap-3 text-sm text-neutral-300">
                    {
                      job.bullets.slice(0, 3).map((bullet) => (
                        <li class="flex gap-3 leading-relaxed">
                          <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-indigo-400"></span>
                          <span>{bullet}</span>
                        </li>
                      ))
                    }
                  </ul>
                </article>
              ))
            }
          </div>

          <div class="rounded-lg border border-white/10 bg-neutral-950/80 p-6">
            <p class="mb-5 text-sm font-bold uppercase tracking-[0.24em] text-neutral-500">
              Education
            </p>
            <div class="space-y-4">
              {
                resumeProfile.education.map((item) => (
                  <article class="rounded-lg border border-white/10 bg-white/[0.03] p-5">
                    <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
                      <div>
                        <h3 class="text-xl font-bold text-white">{item.school}</h3>
                        <p class="mt-1 text-sm font-semibold text-indigo-300">
                          {item.level}
                        </p>
                      </div>
                      <span class="w-fit rounded-full border border-white/10 bg-neutral-950 px-3 py-1 text-xs font-bold text-neutral-300">
                        {item.period}
                      </span>
                    </div>
                    <p class="mt-4 text-sm leading-relaxed text-neutral-300">
                      {item.program}
                    </p>
                  </article>
                ))
              }
            </div>
          </div>
        </section>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
